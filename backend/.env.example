# Copy this file to .env and fill in real values. Never commit .env itself.

FLASK_ENV=development
FLASK_SECRET_KEY=change-me-to-a-random-secret-in-production
FLASK_PORT=5000
LOG_LEVEL=INFO

# Comma-separated list of allowed frontend origins for CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Path to the Firebase service-account JSON key file (download from
# Firebase Console -> Project Settings -> Service Accounts)
FIREBASE_CREDENTIALS_PATH=config/firebase_credentials.json
FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com

# ESP32 hardware communication
ESP32_MODE=wifi
ESP32_IP=192.168.1.50
ESP32_SERIAL_PORT=/dev/ttyUSB0

# Set to "true" only when deploying with an eventlet-based WSGI worker
USE_EVENTLET=false
